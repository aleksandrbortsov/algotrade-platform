{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**", "vendor/**",
      "dist/**", "build/**", "out/**", "coverage/**",
      ".next/**", ".nuxt/**",
      ".git/**", "logs/**", "tmp/**", "temp/**", ".cache/**",
      ".vscode/**", ".idea/**",
      ".taskmaster/tasks/**",
      "apm_modules/**", ".workplace/activated/**",
      "target/**", "*.class", "*.jar", "*.war",
      "TestGeneration/allure-results/**",
      "TestGeneration/tests/Raw/Report/**"
    ]
  },
  "permission": {
    "read": {
      "auth-service/src/main/resources/app.key": "deny",
      "**/logs/**": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "environment": {}
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "task-master-ai": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "task-master-ai"
      ],
      "enabled": true,
      "environment": {
        "TASK_MASTER_TOOLS": "initialize_project,get_tasks,next_task,get_task,set_task_status,add_subtask,remove_task,remove_subtask,clear_subtasks,move_task,add_dependency,remove_dependency,validate_dependencies,fix_dependencies,generate,complexity_report,list_tags,add_tag,delete_tag,use_tag,rename_tag,copy_tag"
      }
    },
    "postman": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@postman/mcp-server"
      ],
      "enabled": true,
      "environment": {
        "POSTMAN_API_KEY": "{env:POSTMAN_API_KEY}"
      }
    },
    "sentry": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sentry/mcp-server"
      ],
      "enabled": true,
      "environment": {
        "SENTRY_AUTH_TOKEN": "{env:SENTRY_AUTH_TOKEN}"
      }
    }
  }
}
